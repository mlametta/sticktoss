+// validity-transition trace in graphics/shared_memory.cpp): after each guest
+// RAM -> upload buffer memcpy overlapping the watched range, re-compare the
+// snapshot against guest RAM. A mismatch proves the guest CPU wrote the range
+// DURING the upload (torn upload - the GPU consumes a half-written frame).
+bool NhlVp6TornWatch(uint32_t start, uint32_t length) {
+  static uint32_t s_start = 0, s_len = 0;
+  static int s_state = -1;
+  if (s_state < 0) {
+    const char* e = std::getenv("NHL_VP6_SM");
+    if (e && *e) {
+      char* colon = nullptr;
+      s_start = uint32_t(std::strtoull(e, &colon, 16));
+      s_len = (colon && *colon == ':') ? uint32_t(std::strtoull(colon + 1, nullptr, 16)) : 0x1000;
+      s_state = 1;
+    } else {
+      s_state = 0;
+    }
+  }
+  return s_state && length && start < s_start + s_len && s_start < start + length;
+}
