+// 1CF32000:384000): trace every validity transition touching that physical
+// range - GPU-write marking (resolve), CPU invalidation, and re-upload from
+// guest RAM - to establish the exact sequence that corrupts the movie frame
+// buffer between the resolve and its texture-cache consumption.
+bool NhlVp6SmWatch(uint32_t start, uint32_t length, uint32_t& watch_start, uint32_t& watch_len) {
+  static uint32_t s_start = 0, s_len = 0;
+  static int s_state = -1;
+  if (s_state < 0) {
+    const char* e = std::getenv("NHL_VP6_SM");
+    if (e && *e) {
+      char* colon = nullptr;
+      s_start = uint32_t(std::strtoull(e, &colon, 16));
+      s_len = (colon && *colon == ':') ? uint32_t(std::strtoull(colon + 1, nullptr, 16)) : 0x1000;
+      s_state = 1;
+    } else {
+      s_state = 0;
+    }
+  }
+  if (!s_state || !length) {
+    return false;
+  }
+  watch_start = s_start;
+  watch_len = s_len;
+  return start < s_start + s_len && s_start < start + length;
+}
